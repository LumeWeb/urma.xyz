---
import Base from "../layouts/Base.astro";
import PageHeader from "../components/PageHeader.astro";
import DataTable from "../components/DataTable.astro";
import Callout from "../components/Callout.astro";

const claimFields = [
  { field: "version", type: "uint8", description: "Protocol version (currently 0)." },
  { field: "location", type: "string", description: "Storage backend identifier (e.g. \"sia\")." },
  { field: "sourceClaimId", type: "string (hex)", description: "40-char lowercase hex of the 20-byte source ClaimID." },
  { field: "dataKey", type: "byte[32]", description: "AES-256 encryption key for file content." },
  { field: "locationData", type: "object", description: "Backend-specific retrieval data. Schema depends on location." },
];

const manifestPageFields = [
  { field: "data", type: "json.RawMessage", description: "Backend-specific manifest payload for this page. Opaque to core." },
  { field: "next", type: "json.RawMessage", description: "Backend-specific pointer to next page. Omitted on last page." },
];

const constants = [
  { field: "ProtocolVersion", type: "uint8", description: "Current protocol version (0)." },
  { field: "MaxClaimScriptSize", type: "int", description: "Maximum on-chain claim script size in bytes (8192)." },
  { field: "SourceClaimIDLen", type: "int", description: "Length of a LBRY ClaimID in bytes (20)." },
  { field: "EnvelopeUnsigned", type: "byte", description: "Envelope version byte for unsigned claims (0x00)." },
  { field: "EnvelopeSigned", type: "byte", description: "Envelope version byte for signed claims (0x01)." },
  { field: "EnvelopeSignedOverhead", type: "int", description: "Signed envelope overhead: 1 + 20 + 64 = 85 bytes." },
  { field: "ClaimScriptOverhead", type: "int", description: "Fixed script overhead: 46 bytes." },
];
---

<Base currentPath="/specification" title="Specification">
  <PageHeader
    eyebrow="Section 02"
    title="Specification"
    description="Technical definitions for the data structures and encoding rules that constitute the underlying fabric of the Urma protocol."
  />

  <!-- 1. Claim Naming -->
  <section class="mb-20 relative">
    <div class="absolute -left-6 top-2 bottom-0 w-px bg-[var(--color-border)] hidden lg:block"></div>
    <div class="flex items-center gap-3 mb-6">
      <span class="star-marker"></span>
      <h2 class="font-[var(--font-serif)] text-2xl font-medium text-[var(--color-ink)]">1. Claim Naming</h2>
    </div>
    <div class="pl-0 lg:pl-6 prose">
      <p class="text-[var(--color-ink)] max-w-[75ch] mb-4">
        Every atomic piece of verifiable data within the protocol is identified by a deterministic claim
        string. The naming convention relies on a consistent prefix followed by a cryptographically
        secure hash.
      </p>
      <div class="bg-[var(--color-ink)] text-[var(--color-code-text)] rounded p-4 inline-block mb-4">
        <code class="font-[var(--font-mono)] text-sm">u-&#123;source_claim_id_hex&#125;</code>
      </div>
      <p class="text-[var(--color-ink)] max-w-[75ch]">
        The <code>u-</code> prefix designates the resource as a native Urma entity, distinct from raw
        IPFS CID hashes or standard domain name pointers. The payload must exactly equal 40 hexadecimal
        characters.
      </p>
    </div>
  </section>

  <!-- 2. Data Structures -->
  <section class="mb-20 relative">
    <div class="absolute -left-6 top-2 bottom-0 w-px bg-[var(--color-border)] hidden lg:block"></div>
    <div class="flex items-center gap-3 mb-6">
      <span class="star-marker"></span>
      <h2 class="font-[var(--font-serif)] text-2xl font-medium text-[var(--color-ink)]">2. Data Structures</h2>
    </div>

    <div class="pl-0 lg:pl-6 space-y-12">
      <DataTable
        title="UrmaClaim"
        subtitle="Primary wrapper for verifiable storage claims."
        fields={claimFields}
      />

      <DataTable
        title="ManifestPage"
        subtitle="Paged chain structure for off-chain manifest data."
        fields={manifestPageFields}
      />

      <Callout title="Note">
        Backend-specific manifest types (blob entries, slab slices, etc.) are defined by each
        backend, not by core. See the <a href="/backends/sia" class="text-[var(--color-thread)] underline">Sia backend</a>{" "}
        for a concrete example.
      </Callout>
    </div>
  </section>

  <!-- 3. Envelope -->
  <section class="mb-20 relative">
    <div class="absolute -left-6 top-2 bottom-0 w-px bg-[var(--color-border)] hidden lg:block"></div>
    <div class="flex items-center gap-3 mb-6">
      <span class="star-marker"></span>
      <h2 class="font-[var(--font-serif)] text-2xl font-medium text-[var(--color-ink)]">3. Envelope & Signing</h2>
    </div>
    <div class="pl-0 lg:pl-6 prose">
      <p class="text-[var(--color-ink)] max-w-[75ch] mb-6">
        Claim values are wrapped in an envelope with a version byte. Unsigned envelopes
        (<code>0x00</code>) contain just the JSON payload. Signed envelopes (<code>0x01</code>)
        include a channel ClaimID and ECDSA signature.
      </p>

      <div class="space-y-4 mb-6">
        <div>
          <p class="label-caps text-[var(--color-muted)] mb-2">Unsigned</p>
          <div class="bg-[var(--color-ink)] text-[var(--color-code-text)] rounded p-4">
            <code class="font-[var(--font-mono)] text-sm">[0x00] [UrmaClaim JSON bytes]</code>
          </div>
        </div>
        <div>
          <p class="label-caps text-[var(--color-muted)] mb-2">Signed</p>
          <div class="bg-[var(--color-ink)] text-[var(--color-code-text)] rounded p-4">
            <code class="font-[var(--font-mono)] text-sm">[0x01] [20-byte channel ClaimID] [64-byte ECDSA signature] [UrmaClaim JSON]</code>
          </div>
        </div>
      </div>

      <Callout title="Warning" icon="warning">
        Invalid signatures cause immediate rejection by clients. The signature digest includes the
        transaction input hash, channel ClaimID, and JSON payload: use
        <code>EncodeSignedEnvelope</code> to ensure correct computation.
      </Callout>
    </div>
  </section>

  <!-- 4. Constants -->
  <section class="mb-20 relative">
    <div class="absolute -left-6 top-2 bottom-0 w-px bg-[var(--color-border)] hidden lg:block"></div>
    <div class="flex items-center gap-3 mb-6">
      <span class="star-marker"></span>
      <h2 class="font-[var(--font-serif)] text-2xl font-medium text-[var(--color-ink)]">4. Constants</h2>
    </div>
    <div class="pl-0 lg:pl-6">
      <DataTable fields={constants} />
    </div>
  </section>
</Base>
