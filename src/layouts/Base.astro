---
import Sidebar from "../components/Sidebar.astro";
import "../styles/global.css";

interface Props {
  currentPath: string;
  title: string;
  description?: string;
  ogImage?: string;
}

const { currentPath, title, description = "A protocol for mirroring content across independent storage networks.", ogImage } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const pageTitle = title === "Urma Protocol" ? "Urma Protocol" : `${title} | Urma Protocol`;
const ogImageURL = new URL(ogImage ?? "/images/og/default.png", canonicalURL.origin);
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL.href} />
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
      rel="stylesheet"
    />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={pageTitle} />
    <meta property="og:site_name" content="Urma Protocol" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:logo" content={new URL("/favicon.svg", canonicalURL.origin).href} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL.href} />
    <meta name="twitter:image:alt" content={pageTitle} />

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Organization",
          "@id": canonicalURL.origin + "/#organization",
          name: "Lume Web",
          url: "https://lumeweb.com",
          logo: {
            "@type": "ImageObject",
            url: new URL("/favicon.svg", canonicalURL.origin).href
          },
          sameAs: [
            "https://github.com/LumeWeb"
          ]
        },
        {
          "@type": "WebSite",
          "@id": canonicalURL.origin + "/#website",
          url: canonicalURL.origin,
          name: "Urma Protocol",
          publisher: {
            "@type": "Organization",
            "@id": canonicalURL.origin + "/#organization"
          }
        },
        {
          "@type": "TechArticle",
          "@id": canonicalURL.href + "#webpage",
          url: canonicalURL.href,
          name: pageTitle,
          description: description,
          isPartOf: {
            "@type": "WebSite",
            "@id": canonicalURL.origin + "/#website"
          }
        }
      ]
    })} />
  </head>
  <body class="antialiased overflow-x-hidden min-h-screen">
    <Sidebar currentPath={currentPath} />
    <main class="md:ml-[280px] p-6 md:p-16 max-w-[1080px] mx-auto">
      <slot />
      <footer class="mt-20 pt-8 border-t border-border">
      <div class="space-y-2">
        <p class="text-sm text-muted">
          A <a href="https://lumeweb.com" class="text-thread underline" target="_blank" rel="noopener">Lume</a> project.
        </p>
        <p class="text-xs text-whisper font-mono">
          IPNS Key:
          <code class="bg-paper-alt px-1 rounded border border-border" title="Content-addressed site identifier">bafzaajaiaejcbmy3cff7oc76gu2zdcak2kvdhd4xuhflmcd4nguxbshgewr6qe4a</code>
        </p>
      </div>
    </footer>
    </main>
  </body>
</html>
